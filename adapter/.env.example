# Copy to adapter/.env. Credentials are read from the environment, never sent to the browser.
# Inside Docker use host.docker.internal; outside Docker use 127.0.0.1.
ENERGY_AGG_SOURCE_DSN=host=host.docker.internal port=15432 dbname=paradigm_db user=reader password=replace-me connect_timeout=8
ENERGY_AGG_TARGET_DSN=host=host.docker.internal port=15432 dbname=student user=writer password=replace-me connect_timeout=8
# Optional separate DSN for the control schema; defaults to target.
# ENERGY_ADAPTER_CONTROL_DSN=host=host.docker.internal port=15432 dbname=student user=controller password=replace-me
ENERGY_ADAPTER_TOKEN=replace-with-random-token-at-least-24-characters
# Optional JSON object with server-side connection aliases. Never submit DSNs through the UI.
# ENERGY_ADAPTER_CONNECTIONS={"customer":"host=host.docker.internal port=15432 dbname=customer user=reader password=replace-me"}
ENERGY_ADAPTER_STATEMENT_TIMEOUT=120
