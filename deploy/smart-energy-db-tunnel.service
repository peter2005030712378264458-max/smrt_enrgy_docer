[Unit]
Description=Smart Energy PostgreSQL SSH tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -L 127.0.0.1:15432:localhost:5432 -i /etc/smart-energy/ssh_key -o UserKnownHostsFile=/etc/smart-energy/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 restricted_user@193.232.208.50
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
