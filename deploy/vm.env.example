# Optional VM overrides. Filled service configuration files are reused.
# No need to duplicate database credentials or the analytics token here.
# An existing DJANGO_SECRET_KEY is reused; otherwise a persistent key is generated.

DJANGO_ALLOWED_HOSTS=193.232.208.42
DJANGO_CSRF_TRUSTED_ORIGINS=https://193.232.208.42
# Existing certificate and private key on the VM; absolute paths also work.
TLS_CERTIFICATE_PATH=./ssl/nginx.crt
TLS_KEY_PATH=./ssl/nginx.key
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
