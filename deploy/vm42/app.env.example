SOURCE_POSTGRES_PASSWORD=replace-me
ENERGY_METADATA_DB_ALIAS=source
ENERGY_ANALYTICS_DB_ALIAS=analytics
ENERGY_HOURLY_TABLE=student_schema.electricity_sensor_readings_hourly
